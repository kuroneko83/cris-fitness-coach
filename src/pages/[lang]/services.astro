---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getTranslation, languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const t = getTranslation(lang);
---

<BaseLayout lang={lang} title={t.nav.services} description={t.servicesSection.subtitle}>
  <section class="relative overflow-hidden bg-charcoal">
    <img src="/images/training.jpg" alt="" class="absolute inset-0 h-full w-full object-cover opacity-30" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-r from-charcoal-deep/95 to-charcoal/60"></div>
    <div class="relative mx-auto max-w-7xl px-5 py-24 sm:py-32">
      <p class="reveal text-sm font-bold tracking-widest text-brand uppercase">{t.servicesSection.kicker}</p>
      <h1 class="reveal reveal-delay-1 font-display mt-3 text-5xl leading-tight font-bold text-white sm:text-6xl">{t.servicesSection.title}</h1>
      <p class="reveal reveal-delay-2 mt-4 max-w-2xl text-lg leading-relaxed text-zinc-300">{t.servicesSection.subtitle}</p>
    </div>
  </section>

  <section class="bg-mist py-20">
    <div class="mx-auto max-w-7xl px-5">
      <div class="grid gap-6 md:grid-cols-3">
        {t.services.map((s, i) => (
          <div class={`reveal reveal-delay-${i + 1} group relative flex flex-col overflow-hidden rounded-2xl border border-black/5 bg-white p-8 transition duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-brand/10`}>
            <span class="font-display absolute -top-4 -right-1 text-9xl font-bold text-black/[0.04]">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="font-display relative text-2xl font-bold text-ink">{s.name}</h2>
            <p class="relative mt-3 flex-1 text-sm leading-relaxed text-body-text">{s.description}</p>
            <ul class="relative mt-5 space-y-2.5 text-sm text-body-text">
              {s.features.map((f) => (
                <li class="flex items-start gap-2.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-brand" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
            <a href={`/${lang}/schedule`} class="relative mt-7 rounded-full bg-brand px-5 py-3 text-center font-bold text-white transition hover:-translate-y-0.5 hover:bg-brand-dark">
              {t.servicesSection.book}
            </a>
          </div>
        ))}
      </div>

      <div class="reveal mt-16 rounded-2xl bg-charcoal p-10 text-center">
        <p class="font-display text-2xl font-bold text-white sm:text-3xl">{t.cta.title}</p>
        <p class="mt-3 text-zinc-300">{t.cta.subtitle}</p>
        <a href={`/${lang}/schedule`} class="mt-6 inline-block rounded-full bg-brand px-8 py-3.5 font-bold text-white transition hover:-translate-y-0.5 hover:bg-brand-dark">
          {t.cta.button} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
