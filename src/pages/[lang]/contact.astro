---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config';
import { getTranslation, languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const t = getTranslation(lang);

const rows = [
  { label: t.contact.addressLabel, value: `${SITE.gym.name} — ${SITE.gym.address}` },
  { label: t.contact.emailLabel, value: SITE.email },
];
const socials = [
  { label: 'Instagram', href: SITE.socials.instagram },
  { label: 'YouTube', href: SITE.socials.youtube },
  { label: 'X', href: SITE.socials.x },
];
---

<BaseLayout lang={lang} title={t.nav.contact} description={t.contact.subtitle}>
  <section class="relative overflow-hidden bg-charcoal">
    <div class="bg-stripes-dark absolute inset-0"></div>
    <div class="relative mx-auto max-w-7xl px-5 py-24 sm:py-32">
      <p class="reveal text-sm font-bold tracking-widest text-brand uppercase">{t.contact.kicker}</p>
      <h1 class="reveal reveal-delay-1 font-display mt-3 text-5xl leading-tight font-bold text-white sm:text-6xl">{t.contact.title}</h1>
      <p class="reveal reveal-delay-2 mt-4 max-w-2xl text-lg leading-relaxed text-zinc-300">{t.contact.subtitle}</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-5">
      <div class="grid gap-10 lg:grid-cols-2">
        <div class="reveal space-y-6">
          {rows.map((r) => (
            <div class="rounded-2xl border border-black/5 bg-mist p-7">
              <p class="text-xs font-bold tracking-widest text-brand uppercase">{r.label}</p>
              <p class="mt-2 font-semibold text-ink">{r.value}</p>
            </div>
          ))}
          <div class="rounded-2xl border border-black/5 bg-mist p-7">
            <p class="text-xs font-bold tracking-widest text-brand uppercase">{t.contact.socialLabel}</p>
            <div class="mt-3 flex gap-5">
              {socials.map((s) => (
                <a href={s.href} target="_blank" rel="noopener" class="font-semibold text-body-text transition hover:text-brand">{s.label}</a>
              ))}
            </div>
          </div>
          <a href={`/${lang}/schedule`} class="inline-flex items-center gap-2 rounded-full bg-brand px-8 py-4 font-bold text-white shadow-lg shadow-brand/25 transition hover:-translate-y-0.5 hover:bg-brand-dark">
            {t.contact.cta} →
          </a>
        </div>

        <div class="reveal reveal-delay-1">
          <div class="overflow-hidden rounded-2xl shadow-sm">
            <!-- TODO: replace with Google Maps embed of the real gym address -->
            <div class="flex aspect-[4/3] items-center justify-center rounded-2xl bg-mist">
              <span class="text-sm text-neutral-400">Google Maps embed placeholder</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
