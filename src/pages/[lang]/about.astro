---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config';
import { getTranslation, languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const t = getTranslation(lang);
---

<BaseLayout lang={lang} title={t.nav.about} description={t.about.p1}>
  <section class="relative overflow-hidden bg-charcoal">
    <div class="bg-stripes-dark absolute inset-0"></div>
    <div class="relative mx-auto max-w-7xl px-5 py-24 sm:py-32">
      <p class="reveal text-sm font-bold tracking-widest text-brand uppercase">{t.about.kicker}</p>
      <h1 class="reveal reveal-delay-1 font-display mt-3 text-5xl leading-tight font-bold text-white sm:text-6xl">{t.about.title}</h1>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-6xl px-5">
      <div class="grid gap-12 md:grid-cols-[2fr_3fr]">
        <div class="reveal">
          <div class="overflow-hidden rounded-2xl shadow-xl shadow-black/10">
            <img src="/images/coach.jpg" alt="Coach Cris" class="aspect-square w-full object-cover" />
          </div>
          <p class="mt-3 text-center text-xs text-neutral-400">Photo placeholder</p>
        </div>

        <div class="reveal reveal-delay-1">
          <p class="text-lg leading-relaxed text-body-text">{t.about.p1}</p>
          <p class="mt-4 leading-relaxed text-body-text">{t.about.p2}</p>
          <p class="mt-4 leading-relaxed text-body-text">{t.about.p3}</p>

          <h2 class="font-display mt-10 text-2xl font-bold text-ink">{t.about.credentialsTitle}</h2>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {t.about.credentials.map((c) => (
              <li class="flex items-start gap-3 rounded-xl border border-black/5 bg-mist p-4 text-sm text-body-text">
                <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-brand"></span>
                {c}
              </li>
            ))}
          </ul>

          <a href={`/${lang}/schedule`} class="mt-10 inline-flex items-center gap-2 rounded-full bg-brand px-8 py-4 font-bold text-white shadow-lg shadow-brand/25 transition hover:-translate-y-0.5 hover:bg-brand-dark">
            {t.hero.ctaPrimary} →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
