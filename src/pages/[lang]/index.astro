---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { SITE } from '../../config';
import { getTranslation, languages, type Lang } from '../../i18n/ui';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const t = getTranslation(lang);

const testimonials = (await getCollection('testimonials'))
  .filter((t) => t.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const stats = [
  { value: '500+', label: t.stats.sessions },
  { value: '300+', label: t.stats.clients },
  { value: '8', label: t.stats.years },
];

const icons: Record<string, string> = {
  scale: 'M12 3a5 5 0 015 5v1h1a1 1 0 011 1v8a2 2 0 01-2 2H7a2 2 0 01-2-2v-8a1 1 0 011-1h1V8a5 5 0 015-5zm0 2a3 3 0 00-3 3v1h6V8a3 3 0 00-3-3z',
  glove: 'M7 3h8a3 3 0 013 3v4a5 5 0 01-5 5H9a5 5 0 01-5-5V6a3 3 0 013-3zm2 14h6a3 3 0 01-3 3h-.5A2.5 2.5 0 019 17z',
  bolt: 'M13 2L4.5 12.5H11L9 22l8.5-10.5H11L13 2z',
  group: 'M9 11a4 4 0 100-8 4 4 0 000 8zm7 1a3 3 0 100-6 3 3 0 000 6zM2 20c0-3 3-5 7-5s7 2 7 5v1H2v-1zm15-3.5c2.5.6 5 2 5 4.5v1h-4v-1.5c0-1.5-.4-2.9-1-4z',
  one: 'M12 2a10 10 0 100 20 10 10 0 000-20zm1 15h-2V9l-2 .5V8l3-1h1v10z',
  shield: 'M12 2l8 3v6c0 5-3.5 9.5-8 11-4.5-1.5-8-6-8-11V5l8-3zm-1 13l5-5-1.4-1.4L11 12.2 9.4 10.6 8 12l3 3z',
};
---

<BaseLayout lang={lang} title={t.nav.home} description={t.hero.subtitle}>
  <!-- Hero (dark photo, like reference) -->
  <section class="relative bg-charcoal">
    <video
      id="hero-video-a"
      class="hero-video"
      src="/videos/boxing.mp4"
      autoplay
      muted
      playsinline
      preload="auto"
    >
    </video>
    <video
      id="hero-video-b"
      class="hero-video is-hidden"
      src="/videos/threadmill.mp4"
      muted
      playsinline
      preload="auto"
    >
    </video>
    <!-- Mobile: vertical gradient, lighter so the boxer's movement is visible -->
    <div class="absolute inset-0 bg-gradient-to-b from-charcoal-deep/80 via-charcoal/40 to-charcoal-deep/90 sm:hidden"></div>
    <!-- Desktop: horizontal gradient keeping text readable -->
    <div class="absolute inset-0 hidden bg-gradient-to-r from-charcoal-deep/95 via-charcoal/80 to-charcoal/30 sm:block"></div>
    <div class="bg-stripes-dark absolute inset-0"></div>

    <div class="relative mx-auto max-w-7xl px-5 pt-28 pb-44 sm:pt-36 sm:pb-56">
      <p class="reveal text-lg font-bold tracking-wide text-zinc-300">{t.hero.welcomeKicker}</p>
      <h1 class="reveal reveal-delay-1 font-display mt-2 max-w-3xl text-5xl leading-[1.05] font-bold text-white sm:text-7xl">
        CRIS BOXING &amp; <span class="text-brand">FITNESS</span>
      </h1>
      <p class="reveal reveal-delay-2 mt-6 max-w-2xl text-lg leading-relaxed text-zinc-300">{t.hero.subtitle}</p>
      <div class="reveal reveal-delay-3 mt-9 flex flex-wrap gap-4">
        <a href={`/${lang}/schedule`} class="group inline-flex items-center gap-2 rounded-full bg-brand px-8 py-4 text-lg font-bold text-white shadow-xl shadow-brand/30 transition hover:-translate-y-0.5 hover:bg-brand-dark">
          {t.hero.ctaPrimary}
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <a href={`/${lang}/services`} class="inline-flex items-center rounded-full border border-white/30 px-8 py-4 text-lg font-bold text-white transition hover:bg-white/10">
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>

    <!-- Overlapping info cards -->
    <div class="relative mx-auto -mb-20 max-w-7xl px-5 sm:-mb-24">
      <div class="grid gap-6 sm:grid-cols-3">
        {t.infoStrip.map((item, i) => (
          <div class={`reveal reveal-delay-${i + 1} rounded-2xl bg-white p-7 shadow-xl shadow-black/10`}>
            <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-full bg-brand/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2l-3.5-3.5-1.4 1.4L9 19 20 8l-1.4-1.4z"/></svg>
            </span>
            <h3 class="font-display text-xl font-bold text-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-body-text">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How We Can Help You -->
  <section class="bg-mist pt-40 pb-24 sm:pt-48">
    <div class="mx-auto max-w-7xl px-5">
      <SectionHeading kicker={t.help.kicker} title={t.help.title} subtitle={t.help.subtitle} />

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {t.benefits.map((b, i) => (
          <div class={`reveal reveal-delay-${(i % 3) + 1} group rounded-2xl border border-black/5 bg-white p-8 transition duration-300 hover:-translate-y-1.5 hover:border-brand/30 hover:shadow-xl hover:shadow-brand/10`}>
            <span class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-brand/10 transition group-hover:bg-brand">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-brand transition group-hover:text-white" viewBox="0 0 24 24" fill="currentColor"><path d={icons[b.icon]} /></svg>
            </span>
            <h3 class="font-display text-xl font-bold text-ink">{b.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-body-text">{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mission (dark charcoal split, like reference) -->
  <section class="bg-charcoal">
    <div class="grid lg:grid-cols-2">
      <div class="relative min-h-80 lg:min-h-full">
        <img src="/images/coach.jpg" alt="Coach Cris training" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
      </div>
      <div class="bg-glow-red-dark bg-stripes-dark relative flex items-center px-5 py-24 lg:px-16">
        <div class="reveal max-w-xl">
          <p class="flex items-center gap-3 text-sm font-bold tracking-widest text-brand uppercase">
            <span class="h-0.5 w-10 bg-brand" aria-hidden="true"></span>
            {t.mission.kicker}
          </p>
          <h2 class="font-display mt-4 text-4xl leading-tight font-bold text-white sm:text-5xl">{t.mission.title}</h2>
          <p class="mt-6 leading-relaxed text-zinc-300">{t.mission.p1}</p>
          <p class="mt-4 leading-relaxed text-zinc-300">{t.mission.p2}</p>
          <p class="font-display mt-8 text-2xl font-bold text-gold">{t.mission.signature}</p>
          <a href={`/${lang}/about`} class="mt-8 inline-flex items-center gap-2 font-bold text-brand transition hover:gap-3">
            {t.nav.about} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-white">
    <div class="mx-auto grid max-w-7xl grid-cols-3 divide-x divide-black/5 px-5 py-16 text-center">
      {stats.map((s, i) => (
        <div class={`reveal reveal-delay-${i + 1} px-2`}>
          <p class="font-display text-4xl font-bold text-brand sm:text-6xl">{s.value}</p>
          <p class="mt-2 text-xs font-semibold tracking-wider text-body-text uppercase sm:text-sm">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Programs -->
  <section class="bg-mist py-24">
    <div class="mx-auto max-w-7xl px-5">
      <SectionHeading kicker={t.servicesSection.kicker} title={t.servicesSection.title} subtitle={t.servicesSection.subtitle} />
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {t.services.map((s, i) => (
          <div class={`reveal reveal-delay-${i + 1} group relative flex flex-col overflow-hidden rounded-2xl border border-black/5 bg-white p-8 transition duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-brand/10`}>
            <span class="font-display absolute -top-4 -right-1 text-9xl font-bold text-black/[0.04]">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-display relative text-2xl font-bold text-ink">{s.name}</h3>
            <p class="relative mt-4 flex-1 text-sm leading-relaxed text-body-text">{s.description}</p>
            <a href={`/${lang}/services`} class="relative mt-6 inline-flex items-center gap-2 font-bold text-brand transition group-hover:gap-3">
              {t.servicesSection.learnMore} <span aria-hidden="true">→</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-white py-24">
    <div class="mx-auto max-w-7xl px-5">
      <SectionHeading kicker={t.testimonials.kicker} title={t.testimonials.title} subtitle={t.testimonials.subtitle} />
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {testimonials.length === 0 ? (
          <p class="text-body-text">{t.testimonials.empty}</p>
        ) : (
          testimonials.map((item, i) => (
            <div class={`reveal reveal-delay-${i + 1}`}>
              <TestimonialCard testimonial={item.data} />
            </div>
          ))
        )}
      </div>
      <div class="mt-10">
        <a href={`/${lang}/testimonials`} class="inline-flex items-center gap-2 font-bold text-brand transition hover:gap-3">
          {t.nav.testimonials} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA banner (red, like reference's "Free Strategy Session") -->
  <section class="relative overflow-hidden bg-brand">
    <div class="bg-stripes-dark absolute inset-0"></div>
    <div class="relative mx-auto max-w-7xl px-5 py-20 text-center">
      <h2 class="reveal font-display mx-auto max-w-3xl text-4xl leading-tight font-bold text-white sm:text-5xl">
        {t.cta.title}
      </h2>
      <p class="reveal reveal-delay-1 mx-auto mt-4 max-w-xl text-lg text-red-100">{t.cta.subtitle}</p>
      <a href={`/${lang}/schedule`} class="reveal reveal-delay-2 mt-9 inline-flex items-center gap-3 rounded-full bg-white px-9 py-4 text-lg font-bold text-brand shadow-xl transition hover:-translate-y-0.5">
        {t.cta.button}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  // Hero video playlist: two stacked <video> elements, both preloaded.
  // When the active clip ends, the next one (already buffered) crossfades in.
  const videoA = document.getElementById('hero-video-a') as HTMLVideoElement | null;
  const videoB = document.getElementById('hero-video-b') as HTMLVideoElement | null;

  if (videoA && videoB) {
    let current = videoA;

    const swap = () => {
      const next = current === videoA ? videoB : videoA;
      next.currentTime = 0;
      next
        .play()
        .then(() => {
          next.classList.remove('is-hidden');
          current.classList.add('is-hidden');
          current.pause();
          current = next;
        })
        .catch(() => {
          // If the next clip is still buffering, retry shortly.
          setTimeout(swap, 500);
        });
    };

    videoA.addEventListener('ended', swap);
    videoB.addEventListener('ended', swap);
  }
</script>

<style>
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% center;
    opacity: 0.55;
    transition: opacity 1s ease;
  }

  .hero-video.is-hidden {
    opacity: 0;
  }

  @media (min-width: 640px) {
    .hero-video {
      object-position: center;
      opacity: 0.4;
    }

    .hero-video.is-hidden {
      opacity: 0;
    }
  }
</style>
