---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslation, languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const t = getTranslation(lang);
---

<BaseLayout lang={lang} title={t.nav.weightLoss} description={t.weightLoss.p1}>
  <section class="relative overflow-hidden bg-charcoal">
    <img src="/images/training.jpg" alt="" class="absolute inset-0 h-full w-full object-cover opacity-30" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-r from-charcoal-deep/95 to-charcoal/60"></div>
    <div class="relative mx-auto max-w-7xl px-5 py-24 text-center sm:py-32">
      <p class="reveal text-sm font-bold tracking-widest text-gold uppercase">{t.weightLoss.kicker}</p>
      <h1 class="reveal reveal-delay-1 font-display mx-auto mt-3 max-w-3xl text-5xl leading-tight font-bold text-white sm:text-6xl">{t.weightLoss.title}</h1>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-5">
      <p class="text-lg leading-relaxed text-body-text">{t.weightLoss.p1}</p>
      <p class="mt-5 text-lg leading-relaxed text-body-text">{t.weightLoss.p2}</p>

      <ol class="mt-14 space-y-6">
        {t.weightLoss.steps.map((step, i) => (
          <li class={`reveal reveal-delay-${i + 1} flex gap-6 rounded-2xl border border-black/5 bg-mist p-7`}>
            <span class="font-display text-5xl font-bold text-brand">{i + 1}</span>
            <div>
              <h2 class="font-display text-xl font-bold text-ink">{step.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-body-text">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="reveal mt-14 rounded-2xl bg-brand p-10 text-center shadow-xl shadow-brand/25">
        <p class="font-display text-2xl font-bold text-white">{t.cta.title}</p>
        <a href={`/${lang}/schedule`} class="mt-6 inline-block rounded-full bg-white px-8 py-3.5 font-bold text-brand transition hover:-translate-y-0.5">
          {t.weightLoss.cta} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
